rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMember(gid) {
      return exists(/databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid));
    }

    // 自分のユーザー情報（参加グループ一覧）
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /groups/{gid} {
      allow read: if signedIn();                       // 招待コードで参加するため
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;

      match /members/{uid} {
        allow read: if signedIn() && isMember(gid);
        // 参加時は自分の分だけ、初期ポイント1000で作成できる
        allow create: if signedIn() && request.auth.uid == uid
                      && request.resource.data.points == 1000;
        // 結果確定時に他の人のポイントも増やすため、メンバー同士は更新可（友達内での利用前提）
        allow update: if signedIn() && isMember(gid);
      }

      match /markets/{mid} {
        allow read: if signedIn() && isMember(gid);
        allow create: if signedIn() && isMember(gid)
                      && request.resource.data.createdBy == request.auth.uid;
        allow update: if signedIn() && isMember(gid);
      }
    }
  }
}
